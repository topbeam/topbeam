{
  "name": "topbeam",
  "version": "0.1.1",
  "description": "Topbeam — vibe coder için dürüst proje panosu: Claude Code transcript'i + git gerçeklerinden deterministik log, kanıt seviyeli durum ve sıradaki-tek-hareket kartı. LLM yok, local-first; CI okuması opsiyonel ve --no-ci ile kapatılabilir.",
  "type": "module",
  "license": "MIT",
  "author": "Ekin Kılıçkaya",
  "keywords": [
    "topbeam",
    "claude-code",
    "cli",
    "local-first",
    "evidence",
    "buildpassport",
    "git",
    "transcript",
    "provenance",
    "vibe-coding",
    "offline"
  ],
  "bin": {
    "topbeam": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
